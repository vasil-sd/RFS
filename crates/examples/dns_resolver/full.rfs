# rfs 1.0
# dns_resolver - LARGE-STATE-SPACE TWIN (Phase 18 A5). A resolver cache with a real
# 16-bit query key and an 8-bit TTL: the cache content IS the state, so no meaningful
# abstraction lowers the state space. Checked via smt-bounded (proves no_stale_serve for
# every k-step path) + fuzz; exact MC is infeasible. The simplified version is pass.rfs.
module dns_resolver {
  enum State { Idle, Querying, Cached }
  initial Idle
  event Lookup(Q(qkey: bit<16>))
  event Reply(R(rkey: bit<16>))
  event Tick
  output SendQuery
  output ServeAnswer
  var key: bit<16> init 0
  var ttl: bit<8> init 0
  # Native property (Phase 18 task 1B): smt-bounded now supports output_has directly,
  # so the witness-variable encoding is retired. A ServeAnswer is only ever emitted by
  # the guarded serve transition (ttl > 0), which leaves ttl unchanged - so at every
  # serving sample the post-step TTL is positive. Renamed event parameter: R(rk) aliases
  # the declared field rkey positionally, and the guard references the binding name.
  prop no_stale_serve : always (output_has(ServeAnswer) -> ttl > 0) ;
  transition Idle on Lookup(Q(qkey)) { next Querying; emit SendQuery; set key = qkey; }
  transition Querying on Reply(R(rk)) where rk == key { next Cached; set ttl = 250; }
  transition Querying on Tick { next Idle; }
  transition Cached on Lookup(Q(qkey)) where qkey == key && ttl > 0 { priority 1; next Cached; emit ServeAnswer; }
  transition Cached on Lookup(Q(qkey)) where qkey != key || ttl == 0 { priority 2; next Querying; emit SendQuery; set key = qkey; }
  transition Cached on Tick where ttl > 0 { next Cached; set ttl = ttl - 1; }
}
