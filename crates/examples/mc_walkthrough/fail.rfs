module timeout_retry_fail {
  enum State { Idle, Sending }
  initial Idle
  event Send
  event Ack
  event Tick
  output Retry
  output Drop
  var timer: bit<3> init 3
  transition Idle on Send {
    next Sending;
    set timer = 3;
  }
  transition Sending on Ack {
    next Idle;
  }
  transition Sending on Tick where timer > 0 {
    next Sending;
    set timer = timer - 1;
    emit Retry;
  }
  transition Sending on Tick where timer == 0 {
    next Idle;
    emit Drop;
  }
  # Teaching violation: the machine may Send and then Tick forever without an
  # Ack, so this obligation can never be guaranteed.
  prop ack_bounded : always (input_is(Send) -> bounded_eventually[2] (input_is(Ack))) ;
}
