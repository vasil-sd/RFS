# rfs 1.0
# sip_call_signaling (Phase 18 A10): a SIP INVITE transaction + dialog (RFC 3261), from
# the caller's view. The call walks Idle -> Invited -> Ringing -> Established, torn down
# by BYE, and cancellable before it is established. Safety: no_established_after_cancel -
# once a CANCEL is received the dialog terminates and can never reach ESTABLISHED.
module sip_call_signaling {
  enum State { Idle, Invited, Ringing, Established, Terminated }
  initial Idle

  event Invite          # local user places the call
  event Recv1xx         # provisional response (100 Trying / 180 Ringing)
  event Recv200Ok       # final success response
  event AckSent         # we acknowledged the 200 OK
  event RecvBye         # remote tears the dialog down
  event RecvCancel      # remote cancels the pending INVITE

  output SendInvite
  output SendAck
  output SendBye

  var cancelled: bit<1> init 0

  # A cancelled invite never reaches ESTABLISHED.
  prop no_established_after_cancel : always (state == Established -> cancelled == 0) ;

  transition Idle on Invite { next Invited; emit SendInvite; }
  transition Invited on Recv1xx { next Ringing; }
  transition Invited on Recv200Ok { next Ringing; }
  # CANCEL terminates the pending invite (this is the fix).
  transition Invited on RecvCancel { next Terminated; set cancelled = 1; }
  transition Ringing on Recv1xx { next Ringing; }
  transition Ringing on Recv200Ok { next Ringing; }
  transition Ringing on AckSent { next Established; emit SendAck; }
  # CANCEL terminates a ringing invite too (this is the fix).
  transition Ringing on RecvCancel { next Terminated; set cancelled = 1; }
  transition Established on RecvBye { next Terminated; emit SendBye; }
  transition Terminated on Invite { next Invited; emit SendInvite; set cancelled = 0; }
}
