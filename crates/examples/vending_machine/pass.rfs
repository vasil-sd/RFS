# rfs 1.0
# vending_machine (Phase 18 B7): a vending machine control FSM - idle -> coin-inserted ->
# product-selected -> dispensing -> change-due, with out-of-stock and jam branches. Money
# is accumulated in cents scaled to bit<6> (the machine takes up to 63 cents - the price
# of 50 fits with change to spare), the product price is fixed at 50, and stock counts
# items (bit<2>, restocked to 3). The FULL-PAYMENT guard is the safety core: a product is
# dispensed only when money >= price - underpaid selections are refunded instead. The
# change arithmetic (owed = money - price, computed in bit-vector subtraction at dispense)
# is pinned by an invariant on the ReturnChange output, and every refund zeroes the held
# money (no loss: a jam or an out-of-stock selection returns everything). Rationale:
# money-accounting guards are a great bit-vector arithmetic exercise.
module vending_machine {
  enum State { Idle, CoinInserted, ProductSelected, Dispensing, ChangeDue, OutOfStock, Jam }
  initial Idle

  event Coin(C(amt: bit<6>))
  event Select
  event DispenseCmd
  event DispenseDone
  event CollectChange
  event Jam
  event Restock
  event Reset

  output Dispense
  output ReturnChange
  output Refund

  var money: bit<6> init 0
  var price: bit<6> init 50
  var stock: bit<2> init 3
  # Change arithmetic witnesses (set at dispense, checked at return).
  var owed: bit<6> init 0
  var change_out: bit<6> init 0

  # Safety: no product is dispensed without full payment.
  prop no_dispense_underpaid : always (output_has(Dispense) -> money >= price) ;
  # Arithmetic invariant: the returned change equals what was owed at dispense.
  prop correct_change : always (output_has(ReturnChange) -> change_out == owed) ;
  # No loss: every refund zeroes the held money (jam / out-of-stock / underpaid).
  prop no_loss_on_refund : always (output_has(Refund) -> money == 0) ;
  # Safety: nothing is dispensed from an empty machine.
  prop no_dispense_out_of_stock : always (output_has(Dispense) -> stock > 0) ;
  # A next-form step semantic (task 3B): a Jam lands the machine in the Jam state, whose
  # ONLY exit is the Reset back to Idle - so the sample after a Jam is Idle. This holds
  # because every step consumes an input: after entering Jam the next input is either
  # Reset (-> Idle) or unhandled (the path terminates, making the next-obligation
  # weak/vacuous). It is the form that FALSE-FAILED under smt-bounded before task 3A (an
  # intervening unhandled input froze the Jam config and the old engine checked
  # next(state == Idle) against it); 3A's liveness gate makes it safe. A bounded_eventually
  # return-to-Idle claim is NOT stated here: the machine can sit in Jam/OutOfStock until a
  # Reset, so that liveness needs an assumption (task 3C's territory).
  prop jam_resets_to_idle : always (input_is(Jam) -> next (state == Idle)) ;

  transition Idle on Coin(C(amt)) { next CoinInserted; set money = money + amt; }
  transition CoinInserted on Coin(C(amt)) { next CoinInserted; set money = money + amt; }
  # Selection: an empty machine refunds instead of selecting.
  transition CoinInserted on Select where stock > 0 { next ProductSelected; }
  transition CoinInserted on Select where stock == 0 { next OutOfStock; emit Refund; set money = 0; }
  # The full-payment guard: dispense only when money >= price, else refund.
  transition ProductSelected on DispenseCmd where money >= price { next Dispensing; emit Dispense; set owed = money - price; set change_out = money - price; }
  transition ProductSelected on DispenseCmd where money < price { next Idle; emit Refund; set money = 0; }
  # Delivery: the stock is decremented when the product actually comes out.
  transition Dispensing on DispenseDone where owed > 0 { next ChangeDue; set stock = stock - 1; }
  transition Dispensing on DispenseDone where owed == 0 { next Idle; set stock = stock - 1; set money = 0; }
  transition ChangeDue on CollectChange { next Idle; emit ReturnChange; set money = 0; }
  # A jam refunds the held money (no loss) and waits for a reset.
  transition Dispensing on Jam { next Jam; emit Refund; set money = 0; }
  transition Jam on Reset { next Idle; }
  transition OutOfStock on Reset { next Idle; }
  # Restocking refills the machine.
  transition Idle on Restock { next Idle; set stock = 3; }
}
