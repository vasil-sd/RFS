module bounded_eventually {
  enum State { Idle, Waiting, Complete }
  initial Idle
  event Start
  event Tick
  output Finished
  transition Idle on Start {
    next Waiting;
  }
  transition Waiting on Tick {
    next Complete;
    emit Finished;
  }
  prop start_finish : always (input_is(Start) -> bounded_eventually[3] (output_has(Finished))) ;
}
