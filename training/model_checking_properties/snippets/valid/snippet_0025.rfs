module enum_types {
  enum State { S }
  initial S
  enum Color { Red, Green, Blue }
  var color: Color init Color::Red
  event ToGreen
  event ToBlue
  output IsGreen
  transition S on ToGreen where color != Color::Green {
    next S;
    set color = Color::Green;
  }
  transition S on ToBlue where color == Color::Green {
    next S;
    set color = Color::Blue;
    emit IsGreen;
  }
}