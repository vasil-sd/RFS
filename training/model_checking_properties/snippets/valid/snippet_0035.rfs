module ticked_service {
  enum State { Idle, Busy }
  initial Idle
  event Req
  event Tick
  output Done
  transition Idle on Req {
    next Busy;
  }
  transition Idle on Tick {
    next Idle;
  }
  transition Busy on Tick {
    next Idle;
    emit Done;
  }
  assume env_ticks : always (bounded_eventually[5] (input_is(Tick))) ;
  prop busy_resolves : always (state == Busy -> bounded_eventually[5] (output_has(Done))) ;
}